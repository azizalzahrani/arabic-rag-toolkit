# OpenAI Configuration
# Get your API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your-openai-key-here

# Anthropic Configuration
# Get your API key from https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# Embedding Model Configuration
# Options: sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2 (recommended)
#          sentence-transformers/paraphrase-multilingual-mpnet-base-v2
#          jinaai/jina-embeddings-v2-small-ar (Arabic-specific)
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Vector Store Configuration
# Options: chroma, faiss
# chroma: Better for small to medium datasets, easier to use
# faiss: Better for large-scale datasets, faster retrieval
VECTOR_STORE=chroma

# Vector Store Path
# Path where vector store data will be stored
VECTOR_STORE_PATH=./data/vector_store

# LLM Provider Configuration
# Options: openai, anthropic, local
# Use 'local' if you want to use a local model (requires setting up Ollama or similar)
LLM_PROVIDER=openai

# OpenAI Model Configuration
# Options: gpt-4, gpt-4-turbo-preview, gpt-3.5-turbo
OPENAI_MODEL=gpt-4

# Anthropic Model Configuration
# Options: claude-3-opus-20240229, claude-3-sonnet-20240229, claude-3-haiku-20240307
ANTHROPIC_MODEL=claude-3-opus-20240229

# Text Chunking Configuration
# CHUNK_SIZE: Number of characters per chunk
# Recommended: 300-500 for Arabic (accounts for morphological structure)
CHUNK_SIZE=300

# CHUNK_OVERLAP: Number of overlapping characters between chunks
# Recommended: 50-100 to maintain context across chunk boundaries
CHUNK_OVERLAP=50

# Retriever Configuration
# Number of top results to retrieve from vector store
TOP_K=5

# Temperature for LLM responses
# Lower values (0.1-0.3) for more deterministic responses
# Higher values (0.7-1.0) for more creative responses
TEMPERATURE=0.3

# Maximum tokens for LLM responses
MAX_TOKENS=2000

# Logging Configuration
# Options: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Database Configuration (if using database backend)
# DATABASE_URL=sqlite:///./arabic_rag.db

# Optional: Local Model Configuration (for Ollama or similar)
# LOCAL_MODEL_ENDPOINT=http://localhost:11434
# LOCAL_MODEL_NAME=mistral:latest
