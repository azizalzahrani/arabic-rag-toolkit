# These variables are read by `ArabicRAGPipeline.from_env()` /
# `arabic_rag.pipeline.config_from_env()`. Export them in your shell or load
# this file with a tool such as python-dotenv before building the pipeline.
#
# Example:
#   from arabic_rag import ArabicRAGPipeline
#   pipeline = ArabicRAGPipeline.from_env()

# OpenAI Configuration
# Get your API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your-openai-key-here

# Anthropic Configuration
# Get your API key from https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# Embedding Model Configuration
# Options: sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2 (recommended)
#          sentence-transformers/paraphrase-multilingual-mpnet-base-v2
#          jinaai/jina-embeddings-v2-small-ar (Arabic-specific)
# Requires the optional extra: pip install "arabic-rag-toolkit[embeddings]"
# Without it, the toolkit uses a built-in local hashing embedder.
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Vector Store Configuration
# Options: memory, chroma, faiss
# memory: no external dependency, best for trying the toolkit quickly
# chroma: Better for small to medium datasets, easier to use
# faiss: Better for large-scale datasets, faster retrieval
VECTOR_STORE=memory

# Vector Store Path
# Path where vector store data will be stored
VECTOR_STORE_PATH=./data/vector_store

# LLM Provider Configuration
# Options: openai, anthropic, local
# 'local' uses the built-in extractive fallback and does not require API keys
LLM_PROVIDER=local

# Model names (optional). If unset, sensible per-provider defaults are used:
# openai -> gpt-4o-mini, anthropic -> claude-sonnet-4-6
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_MODEL=claude-sonnet-4-6

# Text Chunking Configuration
# CHUNK_SIZE: Number of characters per chunk
# Recommended: 300-500 for Arabic (accounts for morphological structure)
CHUNK_SIZE=300

# CHUNK_OVERLAP: Number of overlapping characters between chunks
# Recommended: 50-100 to maintain context across chunk boundaries
CHUNK_OVERLAP=50

# Retriever Configuration
# Number of top results to retrieve from vector store
TOP_K=5

# Temperature for LLM responses
# Lower values (0.1-0.3) for more deterministic responses
# Higher values (0.7-1.0) for more creative responses
TEMPERATURE=0.3

# Maximum tokens for LLM responses
MAX_TOKENS=2000

# Note: the 'local' provider is an extractive fallback implemented inside this
# package - it selects the most relevant sentences from retrieved context and
# does not call any external service.
